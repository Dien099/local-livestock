# ============================================================
# LOCAL LIVESTOCK — ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
# Copy this file and rename it to ".env" (no quotes, just .env)
# Then replace the placeholder values below with your own
# Supabase project's URL and Anon Key.
#
# WHERE TO FIND THESE VALUES:
#   1. Log in to https://supabase.com
#   2. Click on your project
#   3. In the left sidebar, click the gear icon (Project Settings)
#   4. Click "API"
#   5. Copy "Project URL"  -> paste after VITE_SUPABASE_URL=
#   6. Copy "anon public"  -> paste after VITE_SUPABASE_ANON_KEY=
# ============================================================

VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY_HERE
